# muse2api configuration example
# Copy to .env and edit. Values already present in the process environment win.

# Admin and API bearer key (must start with m2a_).
# Leave empty to generate a strong random key on first startup (printed once).
MUSE2API_KEY=m2a_replace_me

# Listener address and port.
MUSE2API_HOST=0.0.0.0
MUSE2API_PORT=18610

# Public base URL used in generated media links (for example https://api.example.com).
# Leave empty to keep relative media URLs and let the admin console use the current origin.
MUSE2API_PUBLIC_BASE=

# Chromium / Chrome executable. Leave empty to auto-detect.
# Linux/Docker: /usr/bin/chromium
# Windows: C:\Program Files\Google\Chrome\Application\chrome.exe
MUSE2API_CHROMIUM=/usr/bin/chromium

# Local DevTools port for the managed browser.
MUSE2API_CDP_PORT=19210

# Generation timeouts in seconds.
MUSE2API_IMAGE_TIMEOUT=240
MUSE2API_VIDEO_TIMEOUT=600
MUSE2API_CHAT_TIMEOUT=300

# Maximum concurrent browser slots (generation and chat share this limit).
MUSE2API_CONCURRENCY=2

# Run keepalive for disabled accounts too (0/1). Disabled accounts never join
# generation or chat routing.
MUSE2API_KEEPALIVE_DISABLED_ACCOUNTS=0

# Reference image safety. Both default to 0 (secure defaults).
# 1 = allow API callers to read server-local file paths.
MUSE2API_REF_IMAGE_LOCAL_FILES=0
# 1 = allow private/loopback URLs when fetching reference images.
MUSE2API_REF_IMAGE_PRIVATE_FETCH=0

# Tool-call protocol injection (0/1). Off by default because muse.ai rejects
# pseudo tool-call JSON; clients that send `tools` are still accepted.
MUSE2API_TOOL_PROTOCOL=0

# Optional update source. The admin update panel compares version.json and
# recent commits against this repository. Leave empty to disable remote checks.
# MUSE2API_REPO=https://github.com/your-account/your-muse2api-fork
MUSE2API_REPO=
MUSE2API_REPO_BRANCH=main
# Optional command run after a successful source update, for example:
# MUSE2API_REBUILD_CMD=go build -o muse2api ./cmd/muse2api
MUSE2API_REBUILD_CMD=

# Optional GitHub token used for update checks and repository push.
GITHUB_TOKEN=

# Optional settings file override (Compose sets /app/data/.env).
# MUSE2API_ENV_FILE=/path/to/persistent/.env
